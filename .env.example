# Copy to .env. Never commit real secrets.

# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Four slashes means an absolute path: /data is the Docker volume.
DATABASE_URL=sqlite:////data/app.db

# Not used yet. Needed for the Spotify auth milestone.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
